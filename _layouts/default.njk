<!DOCTYPE html>
<html lang="en">
  {% include "head.njk" %}

  <body>
    {# {% include "header.njk" %} #}
    {% include "sidepanel.njk" %}

    <section class="content" id="content">
      {{ content | safe }}
    </section>

    {% include "footer.njk" %}

    <!-- Site-wide BreadcrumbList (JSON-LD) - excluded on homepage -->
    {% if url != '/' and url != '/about/' %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://maximvdw.be/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ title }}"
        }
      ]
    }
    </script>
    {% endif %}
  </body>
</html>
