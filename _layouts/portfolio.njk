---
layout: default.njk
---

<div class="container main" itemscope itemtype="http://schema.org/CreativeWork">
    <div class="row">
        <div class="col-sm-3">
            <nav class="navigation">
            {% for post in collections.portfolio %}
                <ul>
                    <li {% if page.url == post.url %}class="selected"{% endif %}>
                    <a href="{{ post.url }}" {% if page.url == post.url %}class="current"{% endif %}>{{ post.data.title }}</a>
                    </li>
                </ul>
            {% endfor %}
            </nav>
        </div>
        <div class="col-sm-9 typography">
            <h1 itemprop="headline">{{ title }}</h1>
            {{ content | safe }}

            {% if video %}
            {% include "video.njk" %}
            {% endif %}

           {% include "gallery.njk" %}
        </div>
    </div>
</div>

<!-- Project Structured Data (JSON-LD) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "{% if github or website %}SoftwareApplication{% else %}CreativeWork{% endif %}",
  "name": "{{ title }}",
  {% if excerpt %}"description": "{{ excerpt | replace('&rsquo;', "'") | truncate(200) }}",{% endif %}
  {% if start %}"dateCreated": "{{ start }}",{% endif %}
  {% if ongoing %}"status": "ActiveProject",{% endif %}
  {% if website or github %}"url": "{{ website | default('') }}"{% endif %},
  {% if github %}"sameAs": ["{{ github }}"]{% endif %}
}
</script>

<!-- BreadcrumbList Structured Data (JSON-LD) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://maximvdw.be/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Portfolio",
      "item": "https://maximvdw.be/portfolio/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ title }}"
    }
  ]
}
</script>
